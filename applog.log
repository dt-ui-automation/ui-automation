#!/bin/sh
safe_curl() { curl -s -o /dev/null -w "%{http_code}\n" -X POST -d "$1" https://api.dev.nimbuz.tech/deployment/v1/deployments/job-status || true; }
fail() { echo "$1"; safe_curl "$2"; exit 1; }

if [ "$JOB_MODE" = "buildDeploy" ]; then
  dockerd --host=unix:///var/run/docker.sock --log-level=error &
  if ! timeout 30 sh -c 'until docker info >/dev/null 2>&1; do sleep 1; done'; then
    echo "Docker failed to start"
    exit 1
  fi
